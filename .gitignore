# Keil build output (each project writes into a folder named after its target)
gimbal/MDK-ARM/CtrBoard-H7_ALL/
chassis/MDK-ARM/ros_stm32/
*.uvguix.*
# Keil pack report: lists the local pack install paths
Packs_*.htm
*.log
*.lst
*.bak
*.dep
JLinkLog.txt

# Host test builds
tests/.build/
chassis/Tests/.build/
*.exe
*.dll
*.o

# Python
__pycache__/
*.pyc

# Vision: calibration images and board-specific calibration stay local
vision/captures/
vision/calibration.json
vision/calibration_*.json
vision/laser_samples*.json
vision/*.zip
# Board copy generated by vision/deploy.ps1 (edit the sources in vision/, then regenerate)
vision/k230_vision/

# Chassis field logs (serial captures, generated plots) stay local
chassis/logs/
chassis/LOGS/

# Editor and tool caches
.vscode/
.sisyphus/
.firecrawl/

# Run data (telemetry csv/png, chassis logs, params) - write new runs with -o logs/<month>/<name>
logs/
